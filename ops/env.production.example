# Plantilla del Core AMG para produccion.
# Copiala al `.env` del servidor o pasala con `docker compose --env-file`.
# Nunca la rellenes con secretos reales dentro del repositorio.

NODE_ENV=production
LOG_LEVEL=info

CORE_PORT=3108
CORE_URL=https://amgdeveloper.cl
CORE_DB_PATH=/app/data/core/core.sqlite
APP_NAME=AMG

# Generar en el servidor:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AMG_SESSION_SECRET=CAMBIA-EN-EL-SERVIDOR
AMG_SSO_ROOT_SECRET=CAMBIA-EN-EL-SERVIDOR

CORE_SESSION_DAYS=30
CORE_SESSION_COOKIE=amg_session
CORE_SESSION_PRUNE_MINUTES=60
CORE_SESSION_RETENTION_DAYS=30
CORE_SSO_CODE_TTL=60
CORE_SSO_TOKEN_TTL=900
CORE_PASSWORD_RESET_TTL_MIN=60
CORE_EMAIL_VERIFY_TTL_MIN=1440

# En produccion solo se aceptan los subdominios publicos del catalogo.
CORE_RETURN_URL_HOSTS=amgdeveloper.cl,www.amgdeveloper.cl
CORE_SSO_LOCAL_CALLBACKS=
CORE_LOCAL_APPS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@amgdeveloper.cl
CONTACT_EMAIL=hola@amgdeveloper.cl

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_MODE=production

CORE_DIAGNOSTICO_KEY=
