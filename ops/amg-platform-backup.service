[Unit]
Description=Backup de AMG Platform (core.sqlite + .env)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=opc
Environment=AMG_PLATFORM_ROOT=/home/opc/projects/amg-platform
Environment=AMG_PLATFORM_BACKUPS=/home/opc/backups/amg-platform
ExecStart=/bin/bash -lc '"$AMG_PLATFORM_ROOT/ops/backup.sh"'
